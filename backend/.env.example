# ==============================================================================
# ResQ-Sense Backend Configuration Environment Variables
# Copy this file to .env in the backend directory to configure your local setup.
# Never commit real credentials or production secrets to Git.
# ==============================================================================

# Authentication & Token Security
# Secret key used for signing JWT access tokens (minimum 32 characters)
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend Base URL (used when generating confirmation email tracking links)
FRONTEND_BASE_URL=http://localhost:5173

# Email Service Configuration (Gmail SMTP)
# How to set up with Gmail:
# 1. Enable 2-Step Verification on the sender Google Account.
# 2. Go to Google Account Settings -> Security -> 2-Step Verification -> App Passwords.
# 3. Create an App Password with name 'ResQ-Sense' (generates a 16-character code).
# 4. Fill in SMTP_USER with your full Gmail address and SMTP_PASSWORD with the 16-character code.
# 5. Set EMAIL_MOCK_MODE=false to enable real live delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-organization-sender@gmail.com
SMTP_PASSWORD=your-16-char-google-app-password
SMTP_FROM_EMAIL=your-organization-sender@gmail.com
SMTP_FROM_NAME=ResQ-Sense Emergency Intelligence
SMTP_TLS=true

# Mock Mode:
# When true, or when SMTP_USER is blank / placeholder, emails are captured in the
# in-memory outbox without reaching external mail servers.
# Set to false once teammate's sender Gmail account credentials are provided.
EMAIL_MOCK_MODE=true

# Citizen Authentication Policy
# When true, citizen incident submission requires a registered citizen account.
REQUIRE_CITIZEN_AUTH=true
